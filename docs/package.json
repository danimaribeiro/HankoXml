{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run docs:api && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "docs:api": "cd .. && bundle exec yard doc --output-dir docs/public/api && mkdir -p docs/public/api/assets && cp assets/hanko-mark.png docs/public/api/assets/"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "preline": "^4.2.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
