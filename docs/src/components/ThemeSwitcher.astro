---
/**
 * Theme picker, adapted from droid's glass theme system (STYLE_GUIDE.md).
 * Four themes — light / dark / system / glass — persisted to localStorage
 * under `hankoxml_theme` and applied as `.dark` / `.glass` classes on
 * <html>. `glass` always implies `dark` (glass is a dark-first theme).
 * `glass` is the default when nothing is persisted yet.
 *
 * The anti-flash-of-unstyled-content script lives inline in Layout.astro's
 * <head> so the theme is applied before first paint; this component only
 * owns the dropdown UI and the click-to-persist behavior.
 */
const themes = [
  { value: 'light', label: 'Light', emoji: '☀️' },
  { value: 'dark', label: 'Dark', emoji: '🌙' },
  { value: 'system', label: 'System', emoji: '💻' },
  { value: 'glass', label: 'Glass', emoji: '✦' },
];
---

<div class="hs-dropdown relative inline-flex" data-hs-dropdown-placement="bottom-right">
  <button
    id="theme-switcher-toggle"
    type="button"
    class="hs-dropdown-toggle py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/10 glass:border-white/[0.15] glass:bg-white/[0.08] glass:text-white glass:hover:bg-white/[0.12]"
  >
    <span id="theme-switcher-emoji" aria-hidden="true">✦</span>
    <span id="theme-switcher-label">Theme</span>
    <svg class="hs-dropdown-open:rotate-180 shrink-0 size-3.5 transition-transform" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </button>

  <div
    class="hs-dropdown-menu transition-[opacity,margin] duration-150 hs-dropdown-open:opacity-100 opacity-0 hidden z-20 mt-2 min-w-32 bg-white shadow-md rounded-lg p-1 dark:bg-slate-800 dark:border dark:border-gray-700 glass:bg-gray-900/90 glass:backdrop-blur-2xl glass:border glass:border-white/[0.12]"
    aria-labelledby="theme-switcher-toggle"
  >
    {themes.map((t) => (
      <button
        type="button"
        data-theme-option={t.value}
        class="theme-option w-full flex items-center gap-x-2 py-2 px-3 rounded-lg text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/10 glass:text-gray-200 glass:hover:bg-white/[0.10]"
      >
        <span aria-hidden="true">{t.emoji}</span>
        {t.label}
      </button>
    ))}
  </div>
</div>

<script>
  const STORAGE_KEY = 'hankoxml_theme';
  const LABELS = {
    light: { label: 'Light', emoji: '☀️' },
    dark: { label: 'Dark', emoji: '🌙' },
    system: { label: 'System', emoji: '💻' },
    glass: { label: 'Glass', emoji: '✦' },
  };

  function currentTheme() {
    return localStorage.getItem(STORAGE_KEY) || 'glass';
  }

  function applyTheme(theme) {
    const isGlass = theme === 'glass';
    const isDark =
      isGlass ||
      theme === 'dark' ||
      (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);

    document.documentElement.classList.toggle('dark', isDark);
    document.documentElement.classList.toggle('glass', isGlass);

    const emojiEl = document.getElementById('theme-switcher-emoji');
    const labelEl = document.getElementById('theme-switcher-label');
    const info = LABELS[theme] || LABELS.glass;
    if (emojiEl) emojiEl.textContent = info.emoji;
    if (labelEl) labelEl.textContent = info.label;
  }

  function setTheme(theme) {
    localStorage.setItem(STORAGE_KEY, theme);
    applyTheme(theme);
  }

  // Reflect the theme the anti-FOUC head script already applied.
  applyTheme(currentTheme());

  document.querySelectorAll('.theme-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      const theme = btn.dataset.themeOption;
      if (theme) setTheme(theme);
    });
  });

  // Keep the "system" theme live if the OS preference changes mid-session.
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (currentTheme() === 'system') applyTheme('system');
    });
</script>
