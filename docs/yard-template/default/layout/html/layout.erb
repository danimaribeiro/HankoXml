<!DOCTYPE html>
<html>
  <head>
    <%= erb(:headers) %>
  </head>
  <body>
    <div id="main_progress" aria-hidden="true"></div>

    <div class="hx-backdrop" aria-hidden="true">
      <div class="hx-backdrop-gradient"></div>
      <div class="hx-orb hx-orb-1"></div>
      <div class="hx-orb hx-orb-2"></div>
      <div class="hx-orb hx-orb-3"></div>
      <div class="hx-crosshatch"></div>
    </div>

    <header class="hx-topbar">
      <a class="hx-brand" href="<%= site_root_url %>">HankoXml</a>
      <nav class="hx-topbar-nav">
        <a href="<%= site_root_url %>guide/getting-started">Guide</a>
        <a href="<%= site_root_url %>reference/signer">Reference</a>
        <a href="<%= site_root_url %>examples/simplest">Examples</a>
        <span class="hx-current">API (YARD)</span>
      </nav>
      <label class="hx-theme-picker">
        <span class="hx-theme-emoji" aria-hidden="true">&#10022;</span>
        <select id="hx-theme-select" aria-label="Theme">
          <option value="light">Light</option>
          <option value="dark">Dark</option>
          <option value="system">System</option>
          <option value="glass">Glass</option>
        </select>
      </label>
    </header>

    <div class="nav_wrap">
      <iframe id="nav" src="<%= @nav_url %>?1"></iframe>
      <div id="resizer"></div>
    </div>

    <div id="main" tabindex="-1">
      <div id="header">
        <%= erb(:breadcrumb) %>
        <%= erb(:search) %>
        <div class="clear"></div>
      </div>

      <div id="content"><%= yieldall %></div>

      <%= erb(:footer) %>
    </div>
  </body>
</html>
