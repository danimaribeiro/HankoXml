module HankoXml
  VERSION: String
  NS: Hash[String, String]

  class Error < StandardError
    PRIVATE_KEY_PEM: Regexp
    FILTERED: String

    attr_reader xmlsec_errors: Array[String]
    attr_accessor signature_node: Nokogiri::XML::Node?

    def self.filter: (untyped value) -> String?
    def initialize: (?untyped message, ?xmlsec_errors: Array[String], ?signature_node: Nokogiri::XML::Node?) -> void
    def xmlsec_errors=: (Array[String] lines) -> Array[String]
  end

  class ConfigurationError < Error end
  class PolicyError < ConfigurationError end
  class PlacementError < ConfigurationError end
  class NokogiriRequired < ConfigurationError end
  class SchemaError < ConfigurationError end
  class ParseError < Error end
  class KeyLoadError < Error end
  class ReferenceError < Error
    attr_accessor reference_uri: String?
  end
  class SigningError < Error end

  class VerificationError < Error end
  class SignatureInvalid < VerificationError end
  class SignatureMissing < VerificationError end
  class MultipleSignatures < VerificationError end
  class UntrustedCertificate < VerificationError end
  class CertificateExpired < VerificationError end
  class DigestMismatch < VerificationError
    attr_accessor reference_uri: String?
  end
  class ResolutionMismatch < VerificationError end

  class NotSignedError < Error end
  class FrozenSignatureError < Error end
  class NativeError < Error end
  class NativeVersionMismatch < NativeError end

  def self.nokogiri?: () -> bool
  def self.capabilities: () -> Hash[Symbol, bool]
  # §6.2: a String of markup, a path-like object, an IO, or a Nokogiri document or node.
  type input = String | _ToPath | _Reader | Nokogiri::XML::Node | Nokogiri::XML::Document

  def self.sign: (input doc_or_xml, **untyped kwargs) -> HankoXml::SignedDocument
  def self.sign!: (Nokogiri::XML::Node | Nokogiri::XML::Document doc, **untyped kwargs) -> (Nokogiri::XML::Node | Nokogiri::XML::Document)
  def self.valid?: (input xml, **untyped kwargs) -> bool
  def self.verify!: (input xml, **untyped kwargs) -> HankoXml::Verification
  def self.signature_present?: (input xml) -> bool
  def self.zero_copy_available?: () -> bool
  def self.parse: (String | IO | _ToPath source) -> Nokogiri::XML::Document
  def self.serialize: (Nokogiri::XML::Document | Nokogiri::XML::Node doc) -> String
end

# Alias
Xmlsec: singleton(HankoXml)

