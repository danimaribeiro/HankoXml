module HankoXml
  class Input
    attr_reader bytes: String
    attr_reader document: Nokogiri::XML::Document?

    def self.read: (untyped source, ?policy: Policy?) -> Input
    def initialize: (String bytes, Nokogiri::XML::Document? document, dom: bool) -> void
    def dom?: () -> bool
    def scan: (Array[String] id_attributes) -> Hash[Symbol, untyped]
  end
end
