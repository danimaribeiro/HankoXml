module HankoXml
  # What <SignedInfo> claims, from Native.inspect_sig: URIs as Strings.
  # Only its readers are listed: it reaches callers as Verification#signed_info
  # / #signature_info and as Policy#violations' argument, and its constructors
  # are @api private.
  class SignatureInfo
    class ReferenceInfo < Struct[untyped]
      attr_accessor uri: String?
      attr_accessor digest_method: String?
      attr_accessor transforms: Array[String]
      attr_accessor id: String?
      attr_accessor type: String?
      attr_accessor xpath_filters: Array[Hash[Symbol, untyped]]

      def digest_method_name: () -> Symbol?
      def transform_names: () -> Array[Symbol?]
      def fragment?: () -> bool
      def external?: () -> bool
      def document_uri: () -> String
      def same_document_xpointer?: () -> bool
      def xpath_filter2?: () -> bool
      def signature_exclusion: () -> (:all | :root_children)?
    end

    attr_reader signature_method: String?
    attr_reader canonicalization_method: String?
    attr_reader signature_count: Integer
    attr_reader key_names: Array[String]
    attr_reader certificates: Array[String]
    attr_reader references: Array[ReferenceInfo]

    def retrieval_method?: () -> bool
    def signature_method_name: () -> Symbol?
    def canonicalization_method_name: () -> Symbol?
  end

  class Verification
    class Reference
      attr_reader uri: String
      attr_reader node: Nokogiri::XML::Node?
      attr_reader digest_method: Symbol?
      attr_reader transforms: Array[Symbol?]
      attr_reader errors: Array[DigestMismatch]
      attr_reader signature_exclusion: (:all | :root_children)?
      def valid?: () -> bool
      def enveloped?: () -> bool
      def signature_exclusions: () -> Array[:this | :all | :root_children]
      def to_h: () -> Hash[Symbol, untyped]
    end

    type algorithm = Symbol | String

    attr_reader valid: bool
    attr_reader errors: Array[Error]
    attr_reader signature_info: SignatureInfo?
    attr_reader signature_node: Nokogiri::XML::Node?
    attr_reader document: Nokogiri::XML::Document?
    attr_reader signature_element_index: Integer?
    attr_reader certificate: OpenSSL::X509::Certificate?
    attr_reader id_attributes: Array[String | [String, String]]
    attr_reader namespaces: Hash[String, String]
    attr_reader resolver: untyped
    attr_reader references: Array[Reference]
    attr_reader reference_element_indexes: Array[Integer?]?
    attr_reader reference_valid: Array[bool?]?

    def initialize: (
      valid: bool,
      errors: Array[Error],
      signature_info: SignatureInfo?,
      signature_node: Nokogiri::XML::Node?,
      document: Nokogiri::XML::Document?,
      ?certificate: OpenSSL::X509::Certificate?,
      ?id_attributes: Array[String | [String, String]]?,
      ?resolver: untyped,
      ?reference_element_indexes: Array[Integer?]?,
      ?reference_valid: Array[bool?]?,
      ?namespaces: Hash[String | Symbol, String]?,
      ?signature_element_index: Integer?,
      ?certificate_chain: Array[OpenSSL::X509::Certificate]?,
      ?root_signature: bool?,
      ?trusted: bool
    ) -> void

    def valid?: () -> bool
    def signature_method: () -> algorithm?
    def canonicalization_method: () -> algorithm?
    def digest_methods: () -> Array[algorithm]
    def signed?: (Nokogiri::XML::Node node) -> bool
    def signed_nodes: () -> Array[Nokogiri::XML::Node]
    def trusted?: () -> bool
    def signed_info: () -> SignatureInfo?
    def certificate_chain: () -> Array[OpenSSL::X509::Certificate]
    def key_info: () -> KeyInfo::Parsed?
    def covers_root?: () -> bool
    def partial?: () -> bool
    def at_signed: (String xpath, ?Hash[String | Symbol, String]? ns) -> Nokogiri::XML::Node
    def signed: (String xpath, ?Hash[String | Symbol, String]? ns) -> Array[Nokogiri::XML::Node]
  end
end
