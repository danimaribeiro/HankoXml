module HankoXml
  module Xades
    NS: String
    LEGACY_NAMESPACES: Array[String]
    NAMESPACES: Array[String]
    SIGNED_PROPERTIES_TYPE: String
    VERSIONED_SIGNED_PROPERTIES_TYPES: Hash[String, String]

    class SignaturePolicy
      attr_reader identifier: String
      attr_reader digest_value: String
      attr_reader digest_method: Symbol | String
      attr_reader description: String?

      def initialize: (identifier: String, digest_value: String, ?digest_method: Symbol | String, ?description: String?) -> void
    end

    class DataObjectFormat
      attr_reader mime_type: String?
      attr_reader description: String?
      attr_reader encoding: String?

      def initialize: (?mime_type: String?, ?description: String?, ?encoding: String?) -> void
    end

    # Takes a DER TimeStampReq, returns the TSA's DER TimeStampResp (#162).
    interface _Timestamper
      def call: (String request_der) -> String
    end

    class Signer < HankoXml::Signer
      attr_reader signing_time: Time?
      attr_reader signature_policy: (SignaturePolicy | :implied)?
      attr_reader claimed_roles: Array[String]
      attr_reader data_object_format: DataObjectFormat?
      attr_reader timestamper: _Timestamper?
      attr_reader timestamp_canonicalization_method: Symbol

      def initialize: (
        ?certificate: (Key | OpenSSL::X509::Certificate | String | _ToPath)?,
        ?signing_time: Time?,
        ?signature_policy: (SignaturePolicy | Hash[Symbol, untyped] | :implied)?,
        ?claimed_roles: Array[String],
        ?data_object_format: (DataObjectFormat | Hash[Symbol, untyped])?,
        ?signature_id: String?,
        ?template: Symbol,
        ?timestamper: _Timestamper?,
        ?timestamp_digest_method: Symbol?,
        ?timestamp_canonicalization_method: Symbol,
        **untyped
      ) ?{ (self) -> void } -> void

      def signed_properties_id: () -> String
      def signature_timestamp_id: () -> String
      def timestamp_digest_method: () -> Symbol
    end
  end
end

module HankoXml
  class XadesError < VerificationError
  end

  module Xades
    class SignedProperties
      attr_reader signing_time: Time?
      attr_reader signature_policy: (SignaturePolicy | :implied)?
      attr_reader claimed_roles: Array[String]
      attr_reader data_object_formats: Array[Hash[Symbol, String?]]
    end

    class Verification < HankoXml::Verification
      attr_reader signed_properties: SignedProperties?
    end

    class Verifier < HankoXml::Verifier
      def initialize: (?signature_policy: (SignaturePolicy | Hash[Symbol, untyped] | :implied)?, **untyped) -> void
      def verify: (untyped xml) -> Verification
      def verify_all: (untyped xml) -> Array[Verification]
    end
  end
end
