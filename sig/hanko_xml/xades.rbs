module HankoXml
  module Xades
    NS: String
    NS141: String
    LEGACY_NAMESPACES: Array[String]
    NAMESPACES: Array[String]
    SIGNED_PROPERTIES_TYPE: String
    VERSIONED_SIGNED_PROPERTIES_TYPES: Hash[String, String]

    class SignaturePolicy
      attr_reader identifier: String
      attr_reader digest_value: String
      attr_reader digest_method: Symbol | String
      attr_reader description: String?

      def initialize: (identifier: String, digest_value: String, ?digest_method: Symbol | String, ?description: String?) -> void
    end

    class DataObjectFormat
      attr_reader mime_type: String?
      attr_reader description: String?
      attr_reader encoding: String?

      def initialize: (?mime_type: String?, ?description: String?, ?encoding: String?) -> void
    end

    # Takes a DER TimeStampReq, returns the TSA's DER TimeStampResp (#162).
    interface _Timestamper
      def call: (String request_der) -> String
    end

    class Signer < HankoXml::Signer
      attr_reader signing_time: Time?
      attr_reader signature_policy: (SignaturePolicy | :implied)?
      attr_reader claimed_roles: Array[String]
      attr_reader data_object_format: DataObjectFormat?
      attr_reader timestamper: _Timestamper?
      attr_reader timestamp_canonicalization_method: Symbol
      attr_reader validation_data: ValidationData?

      def initialize: (
        ?certificate: (Key | OpenSSL::X509::Certificate | String | _ToPath)?,
        ?signing_time: Time?,
        ?signature_policy: (SignaturePolicy | Hash[Symbol, untyped] | :implied)?,
        ?claimed_roles: Array[String],
        ?data_object_format: (DataObjectFormat | Hash[Symbol, untyped])?,
        ?signature_id: String?,
        ?template: Symbol,
        ?timestamper: _Timestamper?,
        ?timestamp_digest_method: Symbol?,
        ?timestamp_canonicalization_method: Symbol,
        ?validation_data: (ValidationData | Hash[Symbol, untyped])?,
        **untyped
      ) ?{ (self) -> void } -> void

      def signed_properties_id: () -> String
      def signature_timestamp_id: () -> String
      def timestamp_digest_method: () -> Symbol
    end

    # XAdES-LT validation material (#167). Embedded, never trusted.
    class ValidationData
      attr_reader certificates: Array[OpenSSL::X509::Certificate]
      attr_reader crls: Array[OpenSSL::X509::CRL]
      attr_reader ocsp_responses: Array[OpenSSL::OCSP::Response]

      def initialize: (
        ?certificates: Array[OpenSSL::X509::Certificate | String | Key],
        ?crls: Array[OpenSSL::X509::CRL | String],
        ?ocsp_responses: Array[OpenSSL::OCSP::Response | String]
      ) -> void
      def self.coerce: ((ValidationData | Hash[Symbol, untyped])? value) -> ValidationData?
    end

    # Adds a SignatureTimeStamp and XAdES-LT validation data to an existing signature (#167).
    class Augmenter
      attr_reader timestamper: _Timestamper?
      attr_reader timestamp_digest_method: Symbol
      attr_reader timestamp_canonicalization_method: Symbol
      attr_reader validation_data: ValidationData?
      attr_reader archive_timestamp: bool
      attr_reader archive_canonicalization_method: Symbol
      attr_reader policy: Policy

      def initialize: (
        ?timestamper: _Timestamper?,
        ?timestamp_digest_method: Symbol,
        ?timestamp_canonicalization_method: Symbol,
        ?validation_data: (ValidationData | Hash[Symbol, untyped])?,
        ?archive_timestamp: bool,
        ?archive_canonicalization_method: Symbol,
        ?policy: Policy
      ) -> void
      def augment: (untyped source, ?signature: Integer?) -> SignedDocument
    end
  end
end

module HankoXml
  class XadesError < VerificationError
  end

  module Xades
    class SignedProperties
      attr_reader signing_time: Time?
      attr_reader signature_policy: (SignaturePolicy | :implied)?
      attr_reader claimed_roles: Array[String]
      attr_reader data_object_formats: Array[Hash[Symbol, String?]]
    end

    class SignatureTimeStamp
      attr_reader id: String?
      attr_reader time: Time
      attr_reader serial_number: Integer
      attr_reader tsa_certificate: OpenSSL::X509::Certificate?
      attr_reader digest_method: String
      attr_reader policy_id: String?
    end

    # The revocation evidence a chain certificate passed with (#168).
    class RevocationStatus
      attr_reader certificate: OpenSSL::X509::Certificate
      attr_reader source: :ocsp | :crl
      attr_reader issued_at: Time
      attr_reader status: :good | :revoked_later
    end

    # A passed XAdES-LT validation (#168).
    class LongTermValidation
      attr_reader time: Time
      attr_reader certificate_chain: Array[OpenSSL::X509::Certificate]
      attr_reader revocation: Array[RevocationStatus]
    end

    class Verification < HankoXml::Verification
      attr_reader signed_properties: SignedProperties?
      attr_reader signature_timestamps: Array[SignatureTimeStamp]?
      attr_reader long_term_validation: LongTermValidation?
      attr_reader archive_timestamps: Array[SignatureTimeStamp]?
      def timestamp_time: () -> Time?
    end

    class Verifier < HankoXml::Verifier
      TIMESTAMP_MODES: Array[Symbol]
      LONG_TERM_MODES: Array[Symbol]

      def initialize: (
        ?signature_policy: (SignaturePolicy | Hash[Symbol, untyped] | :implied)?,
        ?timestamps: :verify | :require | :ignore,
        ?tsa_store: OpenSSL::X509::Store?,
        ?tsa_certificates: Array[OpenSSL::X509::Certificate | String | Key]?,
        ?long_term: (:verify | :require | :ignore)?,
        ?revocation_grace: Numeric,
        **untyped
      ) -> void
      def verify: (untyped xml) -> Verification
      def verify_all: (untyped xml) -> Array[Verification]
    end
  end
end
