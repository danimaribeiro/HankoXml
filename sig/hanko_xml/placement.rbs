module HankoXml
  class Placement
    def self.append_to_root: () -> instance
    def self.prepend_to_root: () -> instance
    def self.after: (String xpath, ?namespaces: Hash[String, String]) -> instance
    def self.before: (String xpath, ?namespaces: Hash[String, String]) -> instance
    def self.append_to: (String xpath, ?namespaces: Hash[String, String]) -> instance
    def self.prepend_to: (String xpath, ?namespaces: Hash[String, String]) -> instance
    def self.detached: () -> instance
    def self.custom: () { (Nokogiri::XML::Document, Nokogiri::XML::Node) -> void } -> instance
    def self.coerce: (instance | Symbol input) -> instance

    def insert: (Nokogiri::XML::Document doc, Nokogiri::XML::Node signature_node) -> void
  end
end
