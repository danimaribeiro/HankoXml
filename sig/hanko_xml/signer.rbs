module HankoXml
  class Signer
    # The setters work only inside the Signer.new block: the Signer is frozen
    # when #initialize returns, after which they raise FrozenError.
    attr_accessor key: Key
    attr_accessor certificate: Key?
    attr_accessor certificates: Array[Key]
    attr_accessor signature_method: Symbol | String
    attr_accessor digest_method: Symbol | String
    attr_accessor canonicalization_method: Symbol | String
    attr_accessor placement: Placement
    attr_accessor references: Array[Reference]
    def key_info=: (Array[KeyInfo::Clause] clauses) -> Array[KeyInfo::Clause]
    attr_accessor id_attributes: Array[String | [String, String]]
    attr_accessor namespaces: Hash[String | Symbol, String]
    attr_accessor signature_id: String?
    attr_accessor policy: Policy
    attr_reader template_mode: Symbol

    def initialize: (
      key: Key | OpenSSL::PKey::PKey | String | _ToPath,
      ?certificate: (Key | OpenSSL::X509::Certificate | String | _ToPath)?,
      ?certificates: Array[Key | OpenSSL::X509::Certificate | String | _ToPath],
      ?signature_method: Symbol | String,
      ?canonicalization_method: Symbol | String,
      ?digest_method: Symbol | String,
      ?references: Array[Reference | String | Hash[Symbol, untyped]],
      ?key_info: Array[Symbol | Hash[Symbol, String]],
      ?placement: Placement | Symbol,
      ?id_attributes: Array[String | [String, String]],
      ?namespaces: Hash[String | Symbol, String],
      ?signature_id: String?,
      ?policy: Policy,
      ?template: Symbol
    ) ?{ (self) -> void } -> void

    def sign: (HankoXml::input doc_or_xml, ?force: bool, ?signature: Integer?) -> HankoXml::SignedDocument
    def sign!: (Nokogiri::XML::Node | Nokogiri::XML::Document doc_or_xml, ?force: bool, ?signature: Integer?) -> (Nokogiri::XML::Node | Nokogiri::XML::Document)
    def template: (HankoXml::input doc_or_xml) -> Nokogiri::XML::Node
    def reference: (?String? uri, **untyped kwargs) -> Array[Reference]
    def key_info: (*Symbol | Hash[Symbol, String] clauses, ?name: String?) -> Array[KeyInfo::Clause]
             | () -> Array[KeyInfo::Clause]
    def to_h: () -> Hash[Symbol, untyped]
    def inspect: () -> String

    private
    def node_signed?: (Nokogiri::XML::Node sig_node) -> bool
    def write_back_signature: (Nokogiri::XML::Document doc, String signed_bytes, Integer index, Nokogiri::XML::Node caller_sig_node) -> void
  end
end
