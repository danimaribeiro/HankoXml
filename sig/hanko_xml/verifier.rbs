module HankoXml
  class Verifier
    DEFAULT_SCHEMA_PATH: String

    # §6.2: a String, a path-like object, an IO, or a Nokogiri document or node.
    type input = String | _ToPath | _Reader | Nokogiri::XML::Node | Nokogiri::XML::Document

    def self.default_schema: () -> Nokogiri::XML::Schema

    TRUST_KEYWORDS: Array[Symbol]

    # #103: integrity only; takes every keyword of #initialize but the trust sources.
    def self.without_trust_verification: (**untyped options) -> Verifier
    def without_trust?: () -> bool

    attr_reader policy: Policy
    attr_reader id_attributes: Array[String | [String, String]]
    attr_reader namespaces: Hash[String, String]
    attr_reader signature: Symbol | Integer | String | nil
    attr_reader verification_time: Time?
    attr_reader schema: Symbol | String | Nokogiri::XML::Schema | nil
    attr_reader referenced_documents: Hash[String, String]
    attr_reader resolver: untyped

    def initialize: (
      ?certificate: (Key | OpenSSL::X509::Certificate | String | _ToPath)?,
      ?certificates: Array[Key | OpenSSL::X509::Certificate | String | _ToPath]?,
      ?store: OpenSSL::X509::Store?,
      ?key: (Key | OpenSSL::PKey::PKey | String | _ToPath)?,
      ?keys: Hash[String, Key | OpenSSL::X509::Certificate | String | _ToPath]?,
      ?policy: Policy,
      ?id_attributes: Array[String | [String, String]],
      ?resolver: untyped,
      ?namespaces: Hash[String, String],
      ?signature: Symbol | Integer | String | nil,
      ?verification_time: Time?,
      ?schema: Symbol | String | Nokogiri::XML::Schema | nil,
      ?referenced_documents: Hash[String, String | Nokogiri::XML::Document],
      ?certificate_subject: (String | OpenSSL::X509::Name)?
    ) -> void

    def verify: (input xml) -> Verification
    def verify!: (input xml, ?allow_untrusted: bool) -> Verification
    def valid?: (input xml) -> bool
    def verify_all: (input xml) -> Array[Verification]
  end
end
